# --- Database (Neon) — required from Foundation phase onward ---
# Used by both the Neon driver adapter (runtime) and the Prisma CLI
# (prisma.config.ts). No separate direct/non-pooled URL is needed — the
# Neon adapter queries over HTTP, not classic TCP.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication (next-auth v4) — Milestone 2 ---
# Required. Generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# GitHub OAuth is designed for (schema.prisma Account table) but not wired
# up until a milestone actually adds the provider.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- AI (Groq / Mock) — added in the AI Features milestone ---
# AI_PROVIDER=mock
# GROQ_API_KEY=

# --- Storage (Cloudinary) — added when a milestone needs file upload ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
