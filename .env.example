# --- Database (Neon) — required from Foundation phase onward ---
# Used by both the Neon driver adapter (runtime) and the Prisma CLI
# (prisma.config.ts). No separate direct/non-pooled URL is needed — the
# Neon adapter queries over HTTP, not classic TCP.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Authentication (next-auth v4) — Milestone 2 ---
# Required. Generate with `openssl rand -base64 32`.
NEXTAUTH_SECRET=
# GitHub OAuth is designed for (schema.prisma Account table) but not wired
# up until a milestone actually adds the provider.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- AI (Groq / Mock) — M7 ---
# Optional — defaults to "mock" (src/config/env.ts) if unset.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=groq (src/config/env.ts fails fast at
# boot if it's missing in that case). Not needed for AI_PROVIDER=mock.
# Get a key at https://console.groq.com/keys — never commit a real one.
# GROQ_API_KEY=

# --- Storage (Cloudinary) — added when a milestone needs file upload ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Email (Resend / Mock) — M8.1 ---
# Optional — defaults to "mock" (src/config/env.ts) if unset. Mock mode
# never sends a real email; it just logs the message server-side, same as
# every previous milestone.
EMAIL_PROVIDER=mock
# Required only when EMAIL_PROVIDER=resend (src/config/env.ts fails fast
# at boot if either is missing in that case). Not needed for
# EMAIL_PROVIDER=mock.
# Get a key at https://resend.com/api-keys — never commit a real one.
# RESEND_API_KEY=
# The "from" address Resend sends as — either a bare address or a
# "Display Name <address>" form. Must be on a domain verified with Resend
# (their sandbox domain works for testing without your own domain).
# EMAIL_FROM="Orbit <onboarding@resend.dev>"
