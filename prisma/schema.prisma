// Prisma 7: the connection URL is not set here — it lives in
// `prisma.config.ts` (CLI operations) and is passed explicitly to the
// Neon driver adapter at runtime (see src/lib/prisma.ts). A separate
// `directUrl` is not needed either: the Neon adapter queries over HTTP,
// which bypasses the prepared-statement limitation that made a
// non-pooled connection necessary for migrations under the old
// classic-TCP setup.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Milestone 2: Identity & Access Management -----------------------

// Platform-level role only (SUPER_ADMIN > ADMIN > USER). This is distinct
// from the per-organization RBAC (Owner/Admin/Member/Viewer) designed in
// System Design — that requires an Organization/Membership model that
// doesn't exist until the Workspace milestone. See docs/adr for the
// scope note if one is added.
enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_VERIFIED
  PROFILE_UPDATED
}

model User {
  id                  String       @id @default(uuid())
  name                String?
  email               String       @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                PlatformRole @default(USER)
  isActive            Boolean      @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  workspaceMemberships WorkspaceMember[]
  ownedProjects        Project[]
  assignedIssues       Issue[]              @relation("IssueAssignee")
  reportedIssues       Issue[]              @relation("IssueReporter")
  comments             Comment[]
  aiGenerationJobs     AiGenerationJob[]
}

// Auth.js Adapter contract — required shape even though only the
// Credentials provider is wired up in Milestone 2. Keeping this now avoids
// a schema migration when GitHub OAuth is added later.
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Auth.js Adapter contract. Not the active session mechanism in
// Milestone 2 (which uses the JWT strategy, per docs/security.md) — kept
// for adapter compatibility and to allow switching strategies later
// without a schema change.
model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth.js Adapter's standard shape (identifier+token+expires) — also
// exactly what our own mock email-verification flow needs, so it's reused
// directly rather than adding a near-duplicate model. `token` stores a
// hash (see PasswordResetToken below for the same reasoning); the row is
// deleted once consumed rather than flagged, matching how Auth.js's own
// adapters treat this table.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Deliberately separate from VerificationToken (an Auth.js Adapter table
// we don't otherwise control) so our own password-reset flow isn't
// coupled to Auth.js's internal contract. Stores a hash of the token, not
// the raw value — see docs/security.md (A02).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// See docs/security.md (A09). userId is nullable so failed-login attempts
// against an email with no matching account are still recorded for
// monitoring; onDelete: SetNull keeps the audit trail intact even if the
// user is later removed.
model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// --- Milestone 3: Workspace & Project Management Core -----------------

// Workspace-level RBAC (Owner > Admin > Member) — distinct from
// PlatformRole (M2), which governs platform administration, not access to
// a specific workspace's resources. The two are deliberately independent:
// a platform SUPER_ADMIN does not automatically gain workspace access.
enum WorkspaceRole {
  MEMBER
  ADMIN
  OWNER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members          WorkspaceMember[]
  projects         Project[]
  labels           Label[]
  aiGenerationJobs AiGenerationJob[]
}

// Exactly one OWNER per workspace is an application-level invariant (see
// the workspace repository in a later increment), not a DB constraint —
// Postgres partial unique indexes aren't expressible in Prisma's schema
// DSL without a raw-SQL migration edit, and this is a documented MVP
// trade-off rather than an oversight.
model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// onDelete: Restrict on owner (not Cascade) — blocks deleting a user while
// they still own projects, forcing explicit reassignment first. No hard
// user-delete feature exists yet (M2 only built soft-deactivation via
// User.isActive), so this is a safety rail more than an active concern
// today.
model Project {
  id           String        @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  status       ProjectStatus @default(ACTIVE)
  ownerId      String
  // Milestone 4: short uppercase prefix for issue keys (e.g. "ORB" ->
  // "ORB-123"). Unique per workspace, not globally — an issue key alone
  // already unambiguously identifies one issue (Decision Point B, approved
  // in the Milestone 4 proposal, see docs/session-log.md), and scoping to
  // the workspace (not the project) matches Milestone 3's own
  // `[workspaceId, name]` uniqueness pattern.
  key          String
  // Incremented atomically (`{ increment: 1 }`, a single Postgres row
  // UPDATE) on every issue creation — this is the *only* safe way to hand
  // out `Issue.number`. Computing `MAX(number) + 1` first and inserting
  // second is a TOCTOU race that produces duplicate keys under concurrent
  // creates, not just a slow loser (worse than the check-then-act pattern
  // already accepted elsewhere in this codebase, e.g. M2's register route).
  issueCounter Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  issues    Issue[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, key])
  @@index([workspaceId])
}

// --- Milestone 4: Task Management Core (Issues) ------------------------

// Values match the design tokens already locked in globals.css
// (--status-backlog/todo/in-progress/in-review/done/cancelled, defined
// since the Phase 3 UI/UX doc, unused in code until now) — not a free
// choice, inventing different values would orphan real design tokens.
enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

// Same reasoning as IssueStatus — matches the locked
// --priority-urgent/high/medium/low/none tokens.
enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

model Issue {
  id          String        @id @default(uuid())
  projectId   String
  // Per-project sequence from Project.issueCounter — the display key
  // ("ORB-123") is computed at the response layer (toIssueResponse) from
  // `project.key` + this number, not stored redundantly here, same
  // single-source-of-truth reasoning as every other response mapper in
  // this codebase (e.g. toWorkspaceResponse).
  number      Int
  title       String
  description String?
  status      IssueStatus   @default(BACKLOG)
  priority    IssuePriority @default(NONE)
  // Fractional index (not an Int position) so reordering one card in the
  // Kanban column only ever touches that one row — a drag-drop insert
  // computes the midpoint between its new neighbors instead of
  // renumbering everything after it. Documented MVP trade-off: float
  // precision degrades after many reorders in the same slot;
  // renormalization is deferred (Milestone 4 Architecture Review, Risk 6).
  position    Float
  assigneeId  String?
  reporterId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade/Restrict: unassigning is a normal, frequent
  // action, not a deletion problem — if the assigned user's account is
  // ever removed, the issue should just become unassigned, not block the
  // removal or disappear itself.
  assignee User?        @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Restrict, matching Project.owner's reasoning: no hard user-delete
  // feature exists yet (M2 only built soft-deactivation), so this is a
  // safety rail, not an active concern today.
  reporter User         @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  labels   IssueLabel[]
  comments Comment[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([assigneeId])
}

// Workspace-scoped (Decision Point F, approved) so a label is reusable
// across every project in the workspace, matching Linear's team-level
// label model — not scoped to one Project.
model Label {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  color       String
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@unique([workspaceId, name])
}

// Plain many-to-many join row — composite primary key instead of a
// surrogate `id` since the pair itself is the whole identity of the row
// (an issue either has a label attached or it doesn't; there's no other
// data to hang off this relationship).
model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model Comment {
  id        String   @id @default(uuid())
  issueId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  // Restrict — same "no hard user-delete yet" safety-rail reasoning as
  // Issue.reporter and Project.owner.
  author User  @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([issueId])
}

// --- Milestone 7: AI Features -------------------------------------------

enum AiProviderType {
  MOCK
  GROQ
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// One row per AI breakdown request — the source of truth for the
// per-workspace daily quota (Increment 2) and an audit trail of what was
// generated, by whom, and with which provider. Deliberately does not store
// the raw provider response (see the M7 audit's AI Safety requirements) —
// only validated output ever reaches application logic in the first place.
model AiGenerationJob {
  id           String             @id @default(uuid())
  workspaceId  String
  userId       String?
  provider     AiProviderType
  status       AiGenerationStatus @default(PENDING)
  prompt       String             @db.Text
  taskCount    Int?
  errorMessage String?
  createdAt    DateTime           @default(now())
  completedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // SetNull, matching AuditLog's reasoning: this is a log/quota record, not
  // an ownership relation — deleting a user shouldn't be blocked by, or
  // erase, their past AI generation history.
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Backs the quota check (Increment 2): COUNT(*) WHERE workspaceId = ...
  // AND createdAt >= start-of-day.
  @@index([workspaceId, createdAt])
  @@index([userId])
}
